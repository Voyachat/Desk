{
  "name": "@voyaseek-ai/dsh-codex-agent",
  "description": "Codex app-server driver: sessions whose runtime is 'codex' use a durable Codex thread",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voyaseek-ai/voyaseek-harness.git",
    "directory": "packages/codex/codex-agent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "plugin": true
  },
  "peerDependencies": {
    "@voyaseek-ai/cordis": "workspace:^",
    "@voyaseek-ai/dsh-agent": "workspace:^",
    "@voyaseek-ai/dsh-agent-loop": "workspace:^",
    "@voyaseek-ai/dsh-credentials": "workspace:^",
    "@voyaseek-ai/dsh-invariants": "workspace:^",
    "@voyaseek-ai/dsh-llm": "workspace:^",
    "@voyaseek-ai/dsh-sandbox-policy": "workspace:^",
    "@voyaseek-ai/dsh-scope": "workspace:^",
    "@voyaseek-ai/dsh-sdk-protocol": "workspace:^",
    "@voyaseek-ai/dsh-session": "workspace:^",
    "@voyaseek-ai/dsh-subprocess": "workspace:^",
    "@voyaseek-ai/dsh-system-prompt": "workspace:^",
    "@voyaseek-ai/dsh-timeout": "workspace:^",
    "@voyaseek-ai/dsh-user-approval": "workspace:^",
    "@voyaseek-ai/dsh-tools": "workspace:^"
  },
  "dependencies": {
    "@openai/codex": "0.147.0",
    "@voyaseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@voyaseek-ai/cordis": "workspace:^",
    "@voyaseek-ai/dsh-agent": "workspace:^",
    "@voyaseek-ai/dsh-agent-loop": "workspace:^",
    "@voyaseek-ai/dsh-credentials": "workspace:^",
    "@voyaseek-ai/dsh-invariants": "workspace:^",
    "@voyaseek-ai/dsh-llm": "workspace:^",
    "@voyaseek-ai/dsh-sandbox-policy": "workspace:^",
    "@voyaseek-ai/dsh-scope": "workspace:^",
    "@voyaseek-ai/dsh-sdk-protocol": "workspace:^",
    "@voyaseek-ai/dsh-session": "workspace:^",
    "@voyaseek-ai/dsh-subprocess": "workspace:^",
    "@voyaseek-ai/dsh-subprocess-local": "workspace:^",
    "@voyaseek-ai/dsh-system-prompt": "workspace:^",
    "@voyaseek-ai/dsh-timeout": "workspace:^",
    "@voyaseek-ai/dsh-user-approval": "workspace:^",
    "@voyaseek-ai/dsh-tools": "workspace:^"
  }
}
