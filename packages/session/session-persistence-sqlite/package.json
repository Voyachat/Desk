{
  "name": "@voyaseek-ai/dsh-session-persistence-sqlite",
  "description": "SQLite durable session persistence with physical chunk-row packing",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voyaseek-ai/voyaseek-harness.git",
    "directory": "packages/session/session-persistence-sqlite"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "resources/sql/**/*.sql",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@voyaseek-ai/dsh-invariants": "workspace:^",
    "@voyaseek-ai/dsh-llm": "workspace:^",
    "@voyaseek-ai/dsh-session": "workspace:^",
    "@voyaseek-ai/dsh-session-persistence": "workspace:^",
    "@voyaseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@voyaseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@voyaseek-ai/cordis-plugin-include": "workspace:^",
    "@voyaseek-ai/cordis-plugin-loader": "workspace:^",
    "@voyaseek-ai/dsh-invariants": "workspace:^",
    "@voyaseek-ai/dsh-llm": "workspace:^",
    "@voyaseek-ai/dsh-session": "workspace:^",
    "@voyaseek-ai/dsh-session-persistence": "workspace:^",
    "@voyaseek-ai/cordis": "workspace:^",
    "typescript": "^6.0.3"
  }
}
