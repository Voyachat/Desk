{
  "name": "@voyaseek-ai/dsh-mobile-view",
  "description": "Header-authenticated read-only mobile session viewer",
  "version": "0.1.0-rc.5",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/voyaseek-ai/voyaseek-harness.git", "directory": "packages/host/mobile-view" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": {
    "@voyaseek-ai/dsh-credentials": "workspace:^",
    "@voyaseek-ai/dsh-host-webserver": "workspace:^",
    "@voyaseek-ai/dsh-invariants": "workspace:^",
    "@voyaseek-ai/dsh-session": "workspace:^",
    "@voyaseek-ai/dsh-session-query": "workspace:^",
    "@voyaseek-ai/dsh-settings": "workspace:^",
    "@voyaseek-ai/cordis": "workspace:^"
  },
  "dependencies": { "@voyaseek-ai/schemastery": "workspace:^" },
  "devDependencies": {
    "@voyaseek-ai/dsh-credentials": "workspace:^",
    "@voyaseek-ai/dsh-host-webserver": "workspace:^",
    "@voyaseek-ai/dsh-invariants": "workspace:^",
    "@voyaseek-ai/dsh-session": "workspace:^",
    "@voyaseek-ai/dsh-session-query": "workspace:^",
    "@voyaseek-ai/dsh-settings": "workspace:^",
    "@voyaseek-ai/cordis": "workspace:^"
  }
}
