{
  "name": "@voyaseek-ai/dsh-aistaff-local-capability-remote",
  "description": "Strict Host-to-Renderer Typert Remote for local capability resources, consent, and receipts",
  "version": "0.1.0-rc.5",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@voyaseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@voyaseek-ai/cordis": "workspace:^",
    "@voyaseek-ai/dsh-aistaff-employee-experience": "workspace:^",
    "@voyaseek-ai/dsh-aistaff-local-capability": "workspace:^",
    "@voyaseek-ai/dsh-invariants": "workspace:^",
    "@voyaseek-ai/dsh-typert-protocol": "workspace:^"
  },
  "devDependencies": {
    "@voyaseek-ai/cordis": "workspace:^",
    "@voyaseek-ai/dsh-aistaff-employee-experience": "workspace:^",
    "@voyaseek-ai/dsh-aistaff-local-capability": "workspace:^",
    "@voyaseek-ai/dsh-api-gateway": "workspace:^",
    "@voyaseek-ai/dsh-invariants": "workspace:^",
    "@voyaseek-ai/dsh-typert-protocol": "workspace:^",
    "@voyaseek-ai/dsh-typert-registry": "workspace:^"
  }
}
