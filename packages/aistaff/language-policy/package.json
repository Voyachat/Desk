{
  "name": "@voyaseek-ai/dsh-aistaff-language-policy",
  "description": "Aistaff product language policy: default output language, per-conversation input-language adaptation, and persisted explicit language rules",
  "version": "0.1.0-rc.5",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/rules-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@voyaseek-ai/dsh-settings": "workspace:^",
    "@voyaseek-ai/dsh-tools": "workspace:^"
  },
  "peerDependencies": {
    "@voyaseek-ai/cordis": "workspace:^",
    "@voyaseek-ai/dsh-invariants": "workspace:^",
    "@voyaseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@voyaseek-ai/cordis": "workspace:^",
    "@voyaseek-ai/dsh-agent": "workspace:^",
    "@voyaseek-ai/dsh-invariants": "workspace:^",
    "@voyaseek-ai/dsh-session": "workspace:^",
    "@voyaseek-ai/schemastery": "workspace:^"
  }
}
