{
  "name": "@voyaseek-ai/dsh-aistaff-cloud-local-conformance-bundle",
  "description": "Test-only deterministic Cloud plus Local Capability conformance composition",
  "version": "0.1.0-rc.5",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@voyaseek-ai/dsh-aistaff-cloud-conformance": "workspace:^",
    "@voyaseek-ai/dsh-aistaff-cloud-local-conformance": "workspace:^",
    "@voyaseek-ai/dsh-aistaff-cloud-local-client-product": "workspace:^",
    "@voyaseek-ai/dsh-aistaff-cloud-provider": "workspace:^",
    "@voyaseek-ai/dsh-aistaff-employee-experience-remote": "workspace:^",
    "@voyaseek-ai/dsh-aistaff-local-capability-remote": "workspace:^"
  },
  "peerDependencies": {
    "@voyaseek-ai/cordis": "workspace:^",
    "@voyaseek-ai/dsh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@voyaseek-ai/cordis": "workspace:^",
    "@voyaseek-ai/dsh-invariants": "workspace:^"
  }
}
