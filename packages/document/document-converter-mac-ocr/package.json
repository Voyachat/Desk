    "@voyaseek-ai/cordis": "workspace:^"
  },
  "dependencies": { "@voyaseek-ai/schemastery": "workspace:^" },
  "optionalDependencies": { "mac-ocr": "1.1.1" },
  "devDependencies": {
    "@voyaseek-ai/dsh-document-converter": "workspace:^",
    "@voyaseek-ai/dsh-invariants": "workspace:^",
    "@voyaseek-ai/cordis": "workspace:^"
  }
