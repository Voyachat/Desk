{
  "name": "@voyaseek-ai/dsh-document-converter-mac-ocr",
  "description": "Local Apple Vision provider for image and PDF OCR to Markdown",
  "version": "0.1.0-rc.5",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voyaseek-ai/voyaseek-harness.git",
    "directory": "packages/document/document-converter-mac-ocr"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
