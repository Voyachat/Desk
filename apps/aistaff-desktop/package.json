{
  "name": "@deepseek-ai/dsh-aistaff-desktop",
  "version": "0.1.0-rc.5",
  "private": true,
  "description": "Voyaseek desktop application",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "stage:runtime": "node ../aistaff-desktop-runtime/scripts/stage-runtime.mjs",
    "verify:runtime": "node ../aistaff-desktop-runtime/scripts/stage-runtime.mjs --verify-only",
    "package": "npm run build && npm run verify:runtime && electron-forge package --platform darwin --arch x64",
    "make": "npm run build && npm run verify:runtime && electron-forge make --platform darwin --arch x64"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/maker-dmg": "8.0.0-alpha.10",
    "@electron-forge/plugin-fuses": "8.0.0-alpha.10",
    "@electron/fuses": "2.1.3",
    "@types/node": "24.13.0",
    "electron": "42.7.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
