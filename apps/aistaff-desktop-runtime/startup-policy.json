{
  "schemaVersion": 1,
  "required": {
    "desktopDist": {
      "root": "apps/aistaff-desktop/dist",
      "extensions": [
        ".js",
        ".cjs"
      ]
    },
    "maxTotalBytes": 98304
  },
  "deferred": {
    "managedRuntimeRoot": "apps/aistaff-desktop-runtime/runtime",
    "activation": "after-browser-window-create"
  },
  "excluded": {
    "nodePtyPrebuilds": {
      "root": "apps/aistaff-desktop-runtime/runtime/node_modules/node-pty/prebuilds",
      "mode": "all-except-target",
      "target": "darwin-x64"
    }
  }
}
